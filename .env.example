# ============================================================
# API-OPS 平台统一配置文件（唯一配置源，勿写入代码）
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略
# ============================================================

# ---------- 数据库（MySQL，中间件 192.168.6.99） ----------
DATABASE_URL=mysql+aiomysql://root:root@192.168.6.99:3306/api_ops

# ---------- Redis（缓存/限流/会话/分布式锁） ----------
REDIS_URL=redis://:RedisDBforeFt20200911@192.168.6.99:6379/0

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- kubeconfig 加密密钥（32 字节 = 256 位，与 Go 端一致） ----------
ENCRYPTION_KEY=change-me-32bytes-key-change-me!!

# ---------- 服务间通信 ----------
K8S_EXECUTOR_GRPC_ADDR=localhost:9090
AI_SERVICE_HTTP_ADDR=http://localhost:9000

# ---------- 钉钉 / 企业微信（通知与回调验签） ----------
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECHAT_WEBHOOK=
WECHAT_TOKEN=
API_HOST=

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- AI 模型（ai-service） ----------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- 可观测性（复用现有基础设施） ----------
PROMETHEUS_URL=
ES_URL=
ES_INDEX_PATTERN=k8s-*
ES_USERNAME=
ES_PASSWORD=

# ---------- AI 成本控制 ----------
DAILY_COST_LIMIT=0
SINGLE_ALERT_COST_LIMIT=0

# ---------- k8s-executor ----------
GRPC_PORT=9090
# api-server 基地址（k8s-executor 写入告警后回调触发立即处理；X-Internal-Token 复用 JWT_SECRET_KEY）
API_SERVER_URL=http://localhost:8080
COMMAND_WHITELIST=get,list,describe,logs,top,explain,rollout,scale,set,apply,patch,delete,exec,create,edit,cordon,uncordon

# ---------- 镜像仓库（R3）列标签用；可选（私有仓库才需要）----------
# 全局只读凭据：
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# 或按 host 配（JSON，优先于全局）：
# REGISTRY_CREDS={"harbor.efreight.cn":{"username":"ro","password":"***"}}

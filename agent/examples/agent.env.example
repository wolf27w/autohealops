# Agent 启动参数说明（平台生成 install.yaml 时会自动写入，这里仅作参考）
#
# 部署形态：单 Deployment（replicas=1），ServiceAccount + ClusterRole/Binding，
# 主动外连平台 gateway（不需要目标集群开放入站端口）。

# 平台 gateway 地址（host:port，mTLS）
-platform=autohealops.example.com:9095

# 平台里的集群 ID（接入向导创建时生成）
-cluster-id=999025

# 接入令牌（平台签发；泄露立即吊销重发）
-token=<接入令牌>

# 是否在 agent 内跑告警检测（Pod/Node watcher → 经隧道上报）
-watch=true

# mTLS：平台自建 CA + 现场签发的客户端证书（由 install.yaml 挂 Secret 到 /tls）
-ca-file=/tls/ca.crt
-cert-file=/tls/tls.crt
-key-file=/tls/tls.key

# 可选：TLS SNI（默认取 -platform 的 host）
# -server-name=autohealops.example.com

# 命令白名单（AI 自动诊断链路用，人工终端不受限）
# -whitelist=get,list,describe,logs,top,explain,rollout,scale,set,apply,patch,delete,exec,create,edit,cordon,uncordon,drain,label,taint

# 时区（平台侧会按时区归一化上报时间；建议保持一致，避免时间轴错位）
# TZ=Asia/Shanghai
